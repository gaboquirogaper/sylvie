<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Sylvie vive en la barra de menú: sin ícono en el Dock desde el arranque -->
  <key>LSUIElement</key>
  <true/>
  <!-- Texto del permiso que macOS muestra al leer/controlar Spotify o Música -->
